# Pinned benchmark datasets — large, fetched locally, not committed.
# See experiments/data/README for source URL + sha256.
data/*.json

# Monitor index (built locally from the pinned dataset) — regenerated on demand.
monitor/longmemeval.sqlite

# Monitor run-trace index (incremental byte-offset cache over experiments/runs/*
# traces, rebuilt on demand) — large and run-specific, never committed.
monitor/cache/

# Monitor server runtime log — stray output, not source.
monitor/monitor.out
